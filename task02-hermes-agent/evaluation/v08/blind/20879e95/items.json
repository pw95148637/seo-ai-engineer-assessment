        "1：有分類，但有推論寫成確定，或未知沒有說明缺什麼資料",
        "2：已知、推論、未知清楚分開，推論標出依據與限度，未知寫明缺哪些資料"
      ]
    },
    "answer_format": {
      "<blind_id>": {
        "unsupported": 0,
        "scope_error": 0,
        "off_page_supported_known": 0,
        "coverage": {
          "on_page": 0,
          "off_page": 0,
          "actionable": 0,
          "epistemic": 0
        },
        "notes": ""
      }
    }
  }
}